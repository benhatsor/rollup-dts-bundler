{
  "name": "rollup-dts-bundler",
  "type": "module",
  "version": "1.0.3",
  "description": "Rollup plugin for high-quality `.d.ts` bundling via @microsoft/api-extractor.",
  "author": "benhatsor",
  "license": "MIT",
  "homepage": "https://github.com/benhatsor/rollup-dts-bundler#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benhatsor/rollup-dts-bundler.git"
  },
  "bugs": {
    "url": "https://github.com/benhatsor/rollup-dts-bundler/issues"
  },
  "keywords": [
    "rollup",
    "rolldown",
    "plugin",
    "dts",
    "typescript",
    "jsdoc"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup -c --configPlugin typescript={tsconfig:\\'rollup.tsconfig.json\\'}",
    "dev": "rollup -c --watch --configPlugin typescript={tsconfig:\\'rollup.tsconfig.json\\'}",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "release": "bumpp"
  },
  "dependencies": {
    "@microsoft/api-extractor": "^7.58.2",
    "@rushstack/node-core-library": "^5.22.0"
  },
  "peerDependencies": {
    "rollup": "^4.0.0",
    "typescript": "^6.0.0"
  },
  "peerDependenciesMeta": {
    "rollup": {
      "optional": true
    }
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.4",
    "bumpp": "^11.0.1",
    "conventional-changelog": "^7.2.0",
    "conventional-changelog-angular": "^8.3.1",
    "rollup": "^4.60.1",
    "semantic-release": "^25.0.3",
    "tslib": "^2.8.1",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  }
}
